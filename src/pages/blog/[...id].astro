---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = `https://lutgaru.com/blog/${entry.id}`;
---

<BaseLayout
  title={`${entry.data.title} | Adrian Sanchez`}
  description={entry.data.description}
  canonical={canonical}
>
  <section
    class="max-w-5xl mx-auto px-6 border-x border-zinc-800 py-12 sm:py-16"
  >
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-widest text-zinc-500 hover:text-primary transition-colors mb-10"
    >
      <span class="material-symbols-outlined" style="font-size:16px"
        >arrow_back</span
      >
      All entries
    </a>

    <article>
      <header class="mb-8">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <a
            href={`/blog?tag=${entry.data.category}`}
            class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-primary/10 border border-primary/30 font-mono text-[10px] uppercase tracking-widest text-primary hover:bg-primary hover:text-on-primary transition-colors"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            {entry.data.category}
          </a>
          {
            entry.data.tags?.map((tag) => (
              <a
                href={`/blog?tag=${tag.toLowerCase()}`}
                title={`Filter by ${tag}`}
                class="px-2.5 py-1 bg-zinc-900 border border-zinc-800 font-mono text-[10px] uppercase tracking-widest text-zinc-500 hover:border-zinc-700 hover:text-zinc-300 transition-colors"
              >
                #{tag}
              </a>
            ))
          }
        </div>

        <time
          class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 tabular-nums block mb-3"
        >
          {
            entry.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>

        <h1
          class="text-2xl sm:text-4xl font-black tracking-tighter uppercase text-on-surface leading-tight"
        >
          {entry.data.title}
        </h1>

        <p class="text-zinc-400 mt-3 text-sm sm:text-base leading-relaxed">
          {entry.data.description}
        </p>

        <div
          class="mt-8 h-px bg-gradient-to-r from-primary/40 via-secondary/15 to-transparent"
        >
        </div>
      </header>

      <div class="prose-content">
        <Content />
      </div>

      <div
        class="mt-12 pt-8 border-t border-zinc-800 flex items-center justify-between"
      >
        <a
          href="/blog"
          class="font-mono text-xs uppercase tracking-widest text-zinc-500 hover:text-zinc-300 transition-colors"
        >
          ← Back to log
        </a>
        <span
          class="font-mono text-[10px] uppercase tracking-widest text-zinc-600"
        >
          lutgaru.com/blog/{entry.id}
        </span>
      </div>
    </article>
  </section>
</BaseLayout>
