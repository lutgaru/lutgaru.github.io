---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog | Adrian Sanchez — Engineering Log"
  description="Engineering notes, devlogs and learnings — from firmware and Rust to local AI and product building."
>
  <section class="max-w-6xl mx-auto px-6 border-x border-zinc-800 py-16 sm:py-24">
    <header class="mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-2 text-[10px] font-mono uppercase tracking-[0.2em] text-secondary mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-secondary gold-glow"></span>
        Blog
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tighter uppercase text-on-surface leading-none">
        Engineering <span class="text-secondary">Log</span>
      </h1>
      <div class="h-1 w-20 bg-primary mt-4"></div>
      <!-- <p class="text-zinc-400 mt-4 text-sm sm:text-base leading-relaxed max-w-xl">
        Notes from the lab — firmware, Rust, local AI, and building products that ship.
        Previously published at <span class="text-zinc-300 font-mono text-xs">babilo.lutgaru.com</span>.
      </p> -->
    </header>

    {
      posts.length === 0 ? (
        <div class="border border-zinc-800 bg-surface-container p-8 text-center">
          <p class="font-mono text-xs uppercase tracking-widest text-zinc-500">No entries yet — check back soon.</p>
        </div>
      ) : (
        <div class="space-y-px bg-zinc-800 border border-zinc-800">
          {posts.map((post) => (
            <article class="bg-background hover:bg-zinc-900 transition-colors group">
              <a href={`/blog/${post.id}`} class="flex items-start justify-between gap-4 p-6 sm:p-8">
                <div class="flex-1 min-w-0">
                  <time class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 tabular-nums">
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  <h2 class="text-lg sm:text-xl font-bold text-on-surface mt-2 group-hover:text-primary transition-colors leading-snug">
                    {post.data.title}
                  </h2>
                  <p class="text-zinc-400 mt-2 text-sm leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                  {post.data.tags && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="px-2.5 py-1 bg-zinc-900 border border-zinc-800 font-mono text-[10px] uppercase tracking-widest text-zinc-500">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <span class="material-symbols-outlined text-zinc-600 group-hover:text-primary transition-colors mt-1 shrink-0 text-xl">
                  arrow_forward
                </span>
              </a>
            </article>
          ))}
        </div>
      )
    }

    <div class="mt-12 flex items-center gap-3 text-[10px] font-mono uppercase tracking-widest text-zinc-600">
      <span class="h-px flex-1 bg-zinc-800"></span>
      {posts.length} entries
      <span class="h-px flex-1 bg-zinc-800"></span>
    </div>
  </section>
</BaseLayout>
